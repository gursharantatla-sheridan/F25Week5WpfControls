<Window x:Class="F25Week5WpfControls.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F25Week5WpfControls"
        mc:Ignorable="d"
        Title="LoginWindow" Height="360" Width="473" FontSize="20" FontWeight="Bold" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Canvas>
        <Label Content="Username" Canvas.Left="64" Canvas.Top="66"/>
        <Label Content="Password" Canvas.Left="70" Canvas.Top="121"/>
        <TextBox x:Name="txtUsername" Canvas.Left="173" Canvas.Top="74" Width="227" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <PasswordBox x:Name="pswPassword" Canvas.Left="173" Canvas.Top="129" Width="227" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Button x:Name="btnLogin" Content="Login" Canvas.Left="88" Canvas.Top="217" HorizontalAlignment="Left" VerticalAlignment="Center" Height="48" Width="118" Background="#FF9AE39D" Click="btnLogin_Click" IsDefault="True"/>
        <Button x:Name="btnCancel" Content="Cancel" Canvas.Left="264" Canvas.Top="217" Height="48" Width="118" Background="#FFEEB3AA" HorizontalAlignment="Left" VerticalAlignment="Center" Click="btnCancel_Click" IsCancel="True"/>
    </Canvas>
</Window>
