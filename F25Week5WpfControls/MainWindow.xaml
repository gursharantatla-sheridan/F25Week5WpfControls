<Window x:Class="F25Week5WpfControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F25Week5WpfControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" FontSize="20" FontWeight="Bold">
    <Canvas>
        <WrapPanel Height="77" Width="142" Canvas.Left="39" Canvas.Top="48" Background="#FFCFF3E4">
            <Button Content="Button 1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Content="Button 2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </WrapPanel>
        <Image Height="74" Canvas.Left="219" Canvas.Top="51" Width="147" Source="/Car.png"/>
        <GroupBox Height="146" Header="Hobbies" Width="181" Canvas.Left="51" Canvas.Top="122" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Canvas>
                <CheckBox x:Name="chkGardening" Content="Gardening" Canvas.Left="10" Canvas.Top="10"/>
                <CheckBox x:Name="chkTravelling" Content="Travelling" Canvas.Left="10" Canvas.Top="41"/>
                <CheckBox x:Name="chkSinging" Content="Singing" Canvas.Left="10" Canvas.Top="72"/>
            </Canvas>
        </GroupBox>
        <Button x:Name="btnGetHobbies" Content="Get Hobbies" Canvas.Left="252" Canvas.Top="141" Click="btnGetHobbies_Click"/>
        <Label x:Name="lblOutput" Canvas.Left="505" Canvas.Top="295" Height="94" Width="266" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFCDFCFF"/>
        <GroupBox Height="146" Header="Gender" Width="181" Canvas.Left="51" Canvas.Top="278" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Canvas>
                <RadioButton x:Name="rdoFemale" Content="Female" Canvas.Left="10" Canvas.Top="10"/>
                <RadioButton x:Name="rdoMale" Content="Male" Canvas.Left="10" Canvas.Top="41" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <RadioButton x:Name="rdoOther" Content="Other" Canvas.Left="10" Canvas.Top="72" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            </Canvas>
        </GroupBox>
        <Button x:Name="btnGetGender" Content="Get Gender" Canvas.Left="252" Canvas.Top="295" Click="btnGetGender_Click"/>
        <ComboBox x:Name="cmbCities" Canvas.Left="400" Canvas.Top="51" Width="194" SelectedIndex="0" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="cmbCities_SelectionChanged">
            <ComboBoxItem Content="Select your City"/>
            <ComboBoxItem Content="Toronto"/>
            <ComboBoxItem Content="Paris"/>
            <ComboBoxItem Content="Nairobi"/>
            <ComboBoxItem Content="Sydney"/>
            <ComboBoxItem Content="Tokyo"/>
        </ComboBox>
        <Button x:Name="btnGetCity" Content="Get City" Canvas.Left="599" Canvas.Top="53" Click="btnGetCity_Click"/>
        <ListBox x:Name="lstCars" Height="186" Width="122" Canvas.Left="400" Canvas.Top="115" HorizontalAlignment="Center" VerticalAlignment="Top" SelectionChanged="lstCars_SelectionChanged" SelectionMode="Extended">
            <ListBoxItem Content="Honda"/>
            <ListBoxItem Content="Toyota"/>
            <ListBoxItem Content="Ford"/>
            <ListBoxItem Content="Kia"/>
            <ListBoxItem Content="Nissan"/>
        </ListBox>
        <Menu Height="30" Width="800" HorizontalAlignment="Center" VerticalAlignment="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New"/>
                <MenuItem Header="_Open"/>
                <MenuItem Header="_Save"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Cu_t"/>
                <MenuItem Header="_Copy"/>
                <MenuItem Header="_Paste"/>
            </MenuItem>
        </Menu>
    </Canvas>
</Window>
